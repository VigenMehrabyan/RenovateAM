{
  "name": "renovateam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter @renovateam/pricing-core build && pnpm --filter @renovateam/api build",
    "lint": "eslint . && node scripts/check-module-boundaries.mjs && prettier --check .",
    "typecheck": "pnpm --filter @renovateam/pricing-core build && pnpm -r typecheck",
    "test": "pnpm --filter @renovateam/pricing-core build && pnpm -r test",
    "db:setup": "pnpm --filter @renovateam/api db:setup",
    "db:seed": "pnpm --filter @renovateam/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
