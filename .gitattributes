# Нормализация переводов строк.
#
# Без этого файла проект, склонированный на Windows, показывает все файлы
# изменёнными: редактор или синхронизация переписывают LF на CRLF, git видит
# другие байты и считает файл правленым. Один такой коммит добавляет десятки
# тысяч строк пустого шума и ломает git blame.
#
# text=auto — git хранит текст с LF в репозитории и сам разбирается с рабочей
# копией; eol=lf — в рабочей копии тоже LF на всех платформах, чтобы редакторы
# не переписывали файлы обратно.

* text=auto eol=lf

# Бинарные файлы не трогать: любая нормализация их повредит.

*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.zip    binary
*.gz     binary
*.bundle binary

# SVG — текст: осмысленные диффы важнее, а переводы строк им не вредят.

*.svg text eol=lf
