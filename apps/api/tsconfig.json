{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@common/*": ["src/common/*"],
      "@config": ["src/config/configuration"],
      "@modules/*": ["src/modules/*"],
      "@db": ["src/generated/prisma/client"],
      "@db/*": ["src/generated/prisma/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "prisma/**/*.ts"]
}
