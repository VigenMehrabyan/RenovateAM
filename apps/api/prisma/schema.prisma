// RenovateAM — схема данных API
// Все денежные суммы хранятся целыми числами в драмах (AMD), без плавающей точки.
// Владелец таблицы указан в комментарии @owner: <модуль>.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  runtime         = "nodejs"
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enum-ы
// ---------------------------------------------------------------------------

/// Роль учётной записи. В MVP сметчик и админ различаются только этим флагом.
enum UserRole {
  CLIENT
  ESTIMATOR
  ADMIN
}

/// Язык интерфейса и писем.
enum Locale {
  RU
  HY
  EN
}

/// Тип объекта (Кобъект).
enum ObjectType {
  APARTMENT
  HOUSE
}

/// Объём работ (Кобъём).
enum WorkScope {
  TURNKEY
  FINISHING
  ROUGH
}

/// Пакет отделки. DESIGNER всегда уходит на ручное рассмотрение.
enum FinishPackage {
  STANDARD
  DESIGNER
}

/// Состояние объекта (Ксостояние).
enum PropertyCondition {
  NEW_BUILDING
  SECONDARY_WITH_DEMOLITION
}

/// Высота потолков (Кпотолки).
enum CeilingHeight {
  UP_TO_3M
  FROM_3M
}

/// Статус заявки.
enum RequestStatus {
  NEW
  IN_PROGRESS
  NEEDS_INFO
  QUOTE_READY
  ACCEPTED
  REJECTED
}

/// Вид загруженного клиентом файла.
enum FileKind {
  BTI
  DESIGN
}

/// Результат решения клиента по смете.
enum DecisionResult {
  ACCEPTED
  REJECTED
}

/// Причина отклонения сметы. OTHER требует заполнения comment.
enum RejectionReason {
  TOO_EXPENSIVE
  TOO_LONG
  CHOSE_ANOTHER_CONTRACTOR
  POSTPONED
  OTHER
}

// ---------------------------------------------------------------------------
// auth
// ---------------------------------------------------------------------------

/// @owner: auth
model User {
  id              String    @id @default(uuid()) @db.Uuid
  fullName        String    @map("full_name") @db.VarChar(200)
  email           String    @unique @db.VarChar(320)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// E.164, всегда +374XXXXXXXX. Не верифицируется, используется для дедупликации.
  phone           String    @db.VarChar(20)
  address         String    @db.VarChar(500)
  passwordHash    String    @map("password_hash") @db.VarChar(72)
  role            UserRole  @default(CLIENT)
  locale          Locale    @default(RU)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  verificationTokens VerificationToken[]
  refreshTokens      RefreshToken[]
  quickEstimates     QuickEstimate[]
  requests           Request[]
  authoredQuotes     Quote[]             @relation("QuoteAuthor")
  createdRateVersion RateVersion[]
  statusLogEntries   StatusLogEntry[]    @relation("StatusLogActor")
  files              RequestFile[]       @relation("FileOwner")

  /// Дедупликация заявок по телефону в админке.
  @@index([phone])
  @@index([role])
  @@map("users")
}

/// @owner: auth — одноразовые ссылки верификации e-mail, TTL 24 часа.
model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 от токена из письма; сырой токен в БД не хранится.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Поиск последнего выпущенного токена пользователя (антиспам «отправить повторно»).
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("verification_tokens")
}

/// @owner: auth — семейства refresh-токенов для ротации и отзыва.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 от refresh-токена.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// Идентификатор цепочки ротации; при повторном использовании отзывается вся цепочка.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(300)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// pricing
// ---------------------------------------------------------------------------

/// @owner: pricing — версия набора ставок. Старые версии не удаляются.
model RateVersion {
  id          String   @id @default(uuid()) @db.Uuid
  createdById String?  @map("created_by") @db.Uuid
  note        String?  @db.VarChar(500)
  /// Ровно одна версия может быть активной; частичный уникальный индекс задаётся миграцией.
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  rates          PricingRate[]
  quickEstimates QuickEstimate[]

  @@index([isActive, createdAt])
  @@index([createdAt])
  @@map("rate_versions")
}

/// @owner: pricing — одна ставка/коэффициент внутри версии.
/// key: base_rate_amd | scope_turnkey | scope_finishing | scope_rough |
///      object_apartment | object_house | condition_new | condition_secondary |
///      ceiling_up_to_3m | ceiling_from_3m | range_min | range_max
model PricingRate {
  id        String  @id @default(uuid()) @db.Uuid
  versionId String  @map("version_id") @db.Uuid
  key       String  @db.VarChar(64)
  /// base_rate_amd хранится как целое число драмов; остальные ключи — множители.
  value     Decimal @db.Decimal(14, 4)

  version RateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@index([versionId])
  @@map("pricing_rates")
}

/// @owner: pricing — сохранённый быстрый расчёт (в т.ч. анонимный).
model QuickEstimate {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String?           @map("user_id") @db.Uuid
  areaSqm       Decimal           @map("area_sqm") @db.Decimal(7, 2)
  objectType    ObjectType        @map("object_type")
  workScope     WorkScope         @map("work_scope")
  finishPackage FinishPackage     @map("finish_package")
  condition     PropertyCondition
  ceilingHeight CeilingHeight     @map("ceiling_height")
  /// null при дизайнерском пакете — суммы не считаются и не показываются.
  amountMin     Int?              @map("amount_min")
  amountMax     Int?              @map("amount_max")
  amountBase    Int?              @map("amount_base")
  needsManual   Boolean           @default(false) @map("needs_manual")
  /// Версия ставок, зафиксированная на старте расчёта.
  rateVersionId String            @map("rate_version_id") @db.Uuid
  /// Расчёт действует 30 дней.
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(3)
  locale        Locale            @default(RU)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  rateVersion RateVersion @relation(fields: [rateVersionId], references: [id], onDelete: Restrict)
  request     Request?

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([rateVersionId])
  @@map("quick_estimates")
}

// ---------------------------------------------------------------------------
// requests
// ---------------------------------------------------------------------------

/// @owner: requests
model Request {
  id              String        @id @default(uuid()) @db.Uuid
  /// Человекочитаемый номер заявки для писем и админки.
  number          Int           @unique @default(autoincrement())
  userId          String        @map("user_id") @db.Uuid
  quickEstimateId String?       @unique @map("quick_estimate_id") @db.Uuid
  status          RequestStatus @default(NEW)
  needsManual     Boolean       @default(false) @map("needs_manual")
  /// Комментарий клиента при создании либо сметчика при статусе NEEDS_INFO.
  comment         String?       @db.VarChar(2000)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  quickEstimate QuickEstimate?   @relation(fields: [quickEstimateId], references: [id], onDelete: SetNull)
  files         RequestFile[]
  quotes        Quote[]
  decision      Decision?
  statusLog     StatusLogEntry[]

  /// Очередь сметчика: фильтр по статусу + сортировка по дате.
  @@index([status, createdAt])
  /// Заявки конкретного пользователя в кабинете.
  @@index([userId, createdAt])
  @@map("requests")
}

/// @owner: requests — журнал смены статусов.
model StatusLogEntry {
  id         String         @id @default(uuid()) @db.Uuid
  requestId  String         @map("request_id") @db.Uuid
  fromStatus RequestStatus? @map("from_status")
  toStatus   RequestStatus  @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  comment    String?        @db.VarChar(2000)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?   @relation("StatusLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
  @@map("status_log")
}

/// @owner: requests — решение клиента по смете. Одно на заявку, необратимо.
model Decision {
  id        String           @id @default(uuid()) @db.Uuid
  requestId String           @unique @map("request_id") @db.Uuid
  result    DecisionResult
  /// Обязательна при result = REJECTED.
  reason    RejectionReason?
  /// Обязателен при reason = OTHER.
  comment   String?          @db.VarChar(2000)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([result, createdAt])
  @@map("decisions")
}

// ---------------------------------------------------------------------------
// files
// ---------------------------------------------------------------------------

/// @owner: files — файлы клиента (план БТИ, дизайн). До 10 на заявку, до 25 МБ.
model RequestFile {
  id           String    @id @default(uuid()) @db.Uuid
  /// Владелец файла. Заполняется всегда: файл может быть загружен до создания заявки.
  userId       String    @map("user_id") @db.Uuid
  /// null, пока файл — черновик и не привязан к заявке.
  requestId    String?   @map("request_id") @db.Uuid
  kind         FileKind
  originalName String    @map("original_name") @db.VarChar(300)
  /// Ключ объекта в R2. Уникален глобально.
  storageKey   String    @unique @map("storage_key") @db.VarChar(500)
  mime         String    @db.VarChar(150)
  /// Размер в байтах, подтверждён HEAD-запросом к R2 после загрузки.
  size         Int
  /// null, пока клиент не подтвердил загрузку; неподтверждённые чистятся заданием.
  uploadedAt   DateTime? @map("uploaded_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  request Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  owner   User     @relation("FileOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId, kind])
  @@index([userId, requestId])
  @@index([uploadedAt])
  @@map("files")
}

// ---------------------------------------------------------------------------
// admin
// ---------------------------------------------------------------------------

/// @owner: admin — PDF-смета, загруженная сметчиком. Актуальна последняя (isCurrent).
model Quote {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  authorId    String?  @map("author_id") @db.Uuid
  /// Ключ PDF-сметы в R2.
  fileKey     String   @unique @map("file_key") @db.VarChar(500)
  /// Итоговая сумма сметы, целое число драмов.
  totalAmount Int      @map("total_amount")
  isCurrent   Boolean  @default(true) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User?   @relation("QuoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([authorId])
  @@map("quotes")
}
