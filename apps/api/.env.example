# --- База данных -----------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/renovateam?schema=public"

# --- Аутентификация --------------------------------------------------------
JWT_SECRET="change-me-access-secret-at-least-32-characters"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-characters"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# --- Хранилище файлов (Cloudflare R2, S3-совместимое) ----------------------
# STORAGE_DRIVER: s3 | memory (memory — только для разработки и тестов)
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET="renovateam"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"

# --- Почта -----------------------------------------------------------------
# MAIL_DRIVER: resend | memory (memory — только для разработки и тестов)
MAIL_DRIVER="resend"
RESEND_API_KEY=""
MAIL_FROM="RenovateAM <noreply@renovateam.am>"
# Адресат уведомлений о принятых сметах (см. ARCHITECTURE.md, открытый вопрос №7)
MANAGER_EMAIL="manager@renovateam.am"

# --- Приложение ------------------------------------------------------------
APP_URL="http://localhost:5173"
PORT="3000"
NODE_ENV="development"

# --- Сид админа ------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@renovateam.am"
SEED_ADMIN_PASSWORD="ChangeMe123"
SEED_ADMIN_NAME="RenovateAM Admin"
SEED_ADMIN_PHONE="+37410000000"
